<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CRUX Audit - {{ notebook_name }}</title>
<style>
  body { font-family: -apple-system, system-ui, sans-serif; max-width: 1000px; margin: 2rem auto; padding: 0 1.5rem; color: #1f2937; line-height: 1.6; }
  .verdict { padding: 1.5rem 2rem; border-radius: 8px; font-size: 1.6rem; font-weight: 700; margin: 1.5rem 0; }
  .verdict.BLOCKED { background: #fee2e2; color: #991b1b; border-left: 8px solid #dc2626; }
  .verdict.READY_WITH_DECISIONS { background: #fef3c7; color: #92400e; border-left: 8px solid #d97706; }
  .verdict.CLEAN { background: #d1fae5; color: #065f46; border-left: 8px solid #059669; }
  table { border-collapse: collapse; width: 100%; margin: 1rem 0; }
  th, td { border: 1px solid #e5e7eb; padding: 0.6rem 0.9rem; text-align: left; }
  th { background: #f9fafb; font-weight: 600; }
  tr.blocker-row { background: #fef2f2; }
  tr.decision-row { background: #fffbeb; }
  tr.auto_patched-row { background: #f0fdf4; }
  .dead { color: #9ca3af; text-decoration: line-through; }
  .load_bearing { color: #047857; font-weight: 600; }
  .scaffolding { color: #1e40af; }
  .exploratory { color: #7c2d12; font-style: italic; }
  pre { background: #f3f4f6; padding: 0.5rem 0.75rem; border-radius: 4px; overflow-x: auto; font-size: 0.85rem; max-width: 600px; white-space: pre-wrap; }
  h1 { border-bottom: 2px solid #e5e7eb; padding-bottom: 0.5rem; }
  h2 { color: #1e293b; margin-top: 2rem; }
  footer { color: #6b7280; font-size: 0.85rem; margin-top: 3rem; padding-top: 1rem; border-top: 1px solid #e5e7eb; }
</style>
</head>
<body>
<h1>CRUX Audit Dossier</h1>
<div class="verdict {{ verdict }}">Verdict: {{ verdict }}</div>

<h2>Stakeholder summary</h2>
<div>{{ summary_html | safe }}</div>

<h2>Gaps detail</h2>
<table>
<tr><th>#</th><th>Severity</th><th>Gap</th><th>Location</th></tr>
{% for g in blockers %}<tr class="blocker-row"><td>{{ g.id }}</td><td><strong>BLOCKER</strong></td><td>{{ g.name }}</td><td>{{ g.location }}</td></tr>{% endfor %}
{% for g in decisions %}<tr class="decision-row"><td>{{ g.id }}</td><td>DECISION ({{ g.options }} opts)</td><td>{{ g.name }}</td><td>-</td></tr>{% endfor %}
{% for g in auto_patched_gaps %}<tr class="auto_patched-row"><td>{{ g.id }}</td><td>AUTO-PATCHED</td><td>{{ g.name }}</td><td>-</td></tr>{% endfor %}
</table>

<h2>Cell-by-cell classification</h2>
<table>
<tr><th>#</th><th>Exec</th><th>Class</th><th>Reason</th><th>Source</th></tr>
{% for c in cells_detail %}
<tr>
  <td>{{ c.index + 1 }}</td>
  <td>{{ c.execution_count if c.execution_count is not none else '-' }}</td>
  <td class="{{ c.classification }}">{{ c.classification }}</td>
  <td>{{ c.reason }}</td>
  <td><pre>{{ c.source_preview }}</pre></td>
</tr>
{% endfor %}
</table>

<footer>
  Generated by CRUX {{ crux_version }} at {{ audit_timestamp }} - deterministic, reproducible<br>
  This dossier is byte-identical across runs (excluding the timestamp). The summary above is rendered from a Jinja2 template - no language model was involved.
</footer>
</body>
</html>